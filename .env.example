# Copie este archivo a .env y complete los valores. .env NO se versiona (ver .gitignore).
# Este ejemplo no contiene secretos reales.

# ---- Base de datos ----
DB_NAME=polizas
DB_USERNAME=polizas
DB_PASSWORD=

# ---- Perfil de logs: json = logs estructurados ECS; vacío = texto legible ----
SPRING_PROFILES_ACTIVE=json
HEALTH_SHOW_DETAILS=always

# ---- IPC ----
# Se exige la clave con periodo ipc_<aaaa>_<mm>. true habilita el respaldo ipc_<mes> (sin año).
IPC_PERMITIR_CLAVE_MENSUAL=false

# ---- Integración con el CORE ----
# SIMULADO (nada llega al CORE real) | WEBLOGIC (requiere todo el bloque WEBLOGIC_*)
CORE_ADAPTADOR=SIMULADO
# Modo del simulador: EXITO | ERROR_HTTP | TIMEOUT | FALLA_Y_RECUPERA
CORE_SIMULADO_MODO=EXITO
CORE_SIMULADO_FALLOS=2
CORE_SIMULADO_HTTP_STATUS=503
CORE_SIMULADO_LATENCIA=0ms

# Reintentos: 1 intento + 3 reintentos cada minuto (max-intentos=4 en application.yml)
CORE_INTERVALO_REINTENTO=1m
# true: un resultado incierto (timeout, 5xx ambiguo) se reenvía con la misma Idempotency-Key.
# false si el CORE no garantiza idempotencia (pasa a FALLIDA para revisión).
CORE_REINTENTAR_INCIERTOS=true
CORE_PROCESADOR_HABILITADO=true

# ---- WebLogic (solo con CORE_ADAPTADOR=WEBLOGIC) ----
# URLs HTTPS, credenciales OAuth 2.0 y certificados mTLS los entrega el responsable del CORE.
# En producción deben provenir de un gestor de secretos, no de un archivo.
WEBLOGIC_MUTACIONES_URL=
WEBLOGIC_TOKEN_URL=
WEBLOGIC_CLIENT_ID=
WEBLOGIC_CLIENT_SECRET=
WEBLOGIC_SCOPE=
WEBLOGIC_CONNECT_TIMEOUT=5s
WEBLOGIC_READ_TIMEOUT=10s
WEBLOGIC_KEYSTORE_PATH=
WEBLOGIC_KEYSTORE_PASSWORD=
WEBLOGIC_KEYSTORE_TYPE=PKCS12
WEBLOGIC_TRUSTSTORE_PATH=
WEBLOGIC_TRUSTSTORE_PASSWORD=
WEBLOGIC_TRUSTSTORE_TYPE=PKCS12
